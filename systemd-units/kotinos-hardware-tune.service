[Unit]
Description=KotinosOS hardware auto-tuning
Documentation=https://github.com/BroJustLeaveMeAlone/KotinosOS

# Writes its fingerprint and decision log under /var, so /var must be the real
# mount rather than the directory the real one is about to cover.
RequiresMountsFor=/var
After=local-fs.target

# Tuning should be in place before the desktop and user sessions start, so the
# first thing the user sees is already running on the right settings.
Before=display-manager.service systemd-user-sessions.service

# Deliberately no ConditionPathExists guard: this runs every boot and exits
# immediately when the hardware fingerprint is unchanged. Gating it on a stamp
# would mean a machine that gained a GPU, or a disk moved to a different
# computer, kept settings chosen for hardware it no longer has.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kotinos-hardware-tune

# Confinement. Reads hardware facts from /sys and writes tuning decisions to
# /etc, so /etc stays writable (ProtectSystem=true, not full) while /usr and
# /boot do not.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# ProtectKernelTunables is deliberately NOT set. It would make /proc/sys and
# /sys read-only, and this is the one service whose whole purpose is kernel
# tunables. Today it only reads /sys and writes drop-ins to /etc/sysctl.d that
# take effect on the next boot, so the option would in fact pass -- which is
# precisely the trap. The first time this service is taught to apply a setting
# live, the option would start silently swallowing it, and the machine would
# boot tuned for hardware it does not have.

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
