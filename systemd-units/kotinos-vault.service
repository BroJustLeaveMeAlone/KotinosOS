[Unit]
Description=Protect irreplaceable files in the vault
Documentation=https://github.com/BroJustLeaveMeAlone/KotinosOS

RequiresMountsFor=/var
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/kotinos-vault backup

# A partial backup exits non-zero, so this unit enters the failed state and
# shows up in `systemctl --failed` rather than passing quietly. That is
# deliberate: the script used to record success no matter what rsync did, so a
# full disk produced a green unit and a vault missing the files it claimed to
# hold. An unattended backup that cannot report failure is not a backup, and the
# failed state is the only thing anyone will notice without going looking.

# The vault must be unmounted when this finishes, whatever happened. The script
# unmounts in a trap, and this is the backstop: a vault left mounted after a
# crashed backup is a vault that is writable until the next reboot, which
# defeats the entire design.
ExecStopPost=-/bin/sh -c 'mountpoint -q /run/kotinos-vault && umount /run/kotinos-vault || true'

# Backing up must never be something the user can feel.
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

# The service handles files it does not own, so limit what else it can reach.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true

# A consequence of the mount namespace worth stating, because it strengthens the
# vault's central claim rather than merely tidying the unit:
#
# PrivateTmp puts this service in its own mount namespace with slave
# propagation, so the vault partition it mounts at /run/kotinos-vault is mounted
# *only inside this service*. No other process on the machine can see that
# mountpoint, let alone write through it -- not just "the window is seconds a
# day", but "even during that window the vault is not in anyone else's view of
# the filesystem". The adversarial test should confirm this rather than take it
# on faith.
#
# RestrictSUIDSGID is deliberately NOT set. The backup runs `rsync -aHAX`, which
# reproduces setuid and setgid bits faithfully; restricting them would give a
# vault whose restored files differ from the originals in a way nobody would
# notice until a restore behaved oddly.

StandardOutput=journal
StandardError=journal
