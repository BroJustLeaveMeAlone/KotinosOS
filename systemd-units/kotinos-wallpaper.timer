[Unit]
Description=Follow the time of day with the wallpaper
Documentation=https://github.com/BroJustLeaveMeAlone/KotinosOS

[Timer]
# Hourly is enough: the phases are hours long, and the script exits immediately
# when the phase has not changed.
OnStartupSec=1min
OnUnitActiveSec=1h

# Catch up after suspend. A laptop opened in the evening should not still be
# showing the morning wallpaper until the next tick.
Persistent=true

[Install]
WantedBy=timers.target
