[Unit]
Description=KotinosOS first-boot provisioning
Documentation=https://github.com/BroJustLeaveMeAlone/KotinosOS

# /var is a separate btrfs subvolume and is what we provision into, so it must
# be mounted first -- otherwise the account would be written to the directory
# the real /var is about to cover.
RequiresMountsFor=/var
After=local-fs.target

# The account and its authorized_keys must exist before anything can log in.
Before=systemd-user-sessions.service sshd.service display-manager.service

# Cheap short-circuit on every subsequent boot; the script re-checks too.
ConditionPathExists=!/var/lib/kotinos/.provisioned

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kotinos-firstboot

# Confinement. Provisioning creates the user account, so it writes /etc/passwd,
# /etc/shadow and a home under /var: /etc must stay writable, which is why this
# is ProtectSystem=true rather than full. /usr and /boot are read-only, and the
# key material it copies out of /usr is only ever read.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true

# RestrictSUIDSGID is deliberately NOT set: useradd and the home-directory
# skeleton set group-sticky bits, and denying that would leave a subtly wrong
# account rather than an obvious failure.

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
